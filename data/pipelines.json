{
  "version": 1,
  "_comment": "FlowEdge 的唯一产品形态：固定出片流水线。字段 bind = 向导参数写到哪个节点的哪个 data 键；when = 该节点是否入选（field 或 field=value）。改这里不用重编译。",
  "pipelines": [
    {
      "id": "image",
      "name": "文生图",
      "summary": "一句话出一个画面；可开质量循环自动重采样择优",
      "output": "image",
      "est_seconds": 60,
      "fields": [
        {
          "key": "prompt",
          "label": "画面描述",
          "type": "textarea",
          "required": true,
          "hint": "中文就行。写清主体、光线、材质、镜头",
          "bind": [
            {
              "node": "start-1",
              "path": "prompt"
            }
          ]
        },
        {
          "key": "width",
          "label": "宽",
          "type": "int",
          "default": 1024,
          "min": 384,
          "max": 1536,
          "bind": [
            {
              "node": "t2i-1",
              "path": "width"
            }
          ]
        },
        {
          "key": "height",
          "label": "高",
          "type": "int",
          "default": 1024,
          "min": 384,
          "max": 1536,
          "bind": [
            {
              "node": "t2i-1",
              "path": "height"
            }
          ]
        },
        {
          "key": "batch",
          "label": "张数",
          "type": "int",
          "default": 1,
          "min": 1,
          "max": 4,
          "bind": [
            {
              "node": "t2i-1",
              "path": "batch"
            }
          ]
        },
        {
          "key": "qc",
          "label": "质量循环",
          "type": "bool",
          "default": false,
          "hint": "不太满意时打开：生成→验收→改参数→重跑→择优，慢 max_rounds 倍"
        }
      ],
      "nodes": [
        {
          "id": "start-1",
          "type": "start",
          "data": {
            "prompt": ""
          }
        },
        {
          "id": "t2i-1",
          "type": "text2image",
          "data": {
            "prompt": "",
            "prompts": "",
            "split_lines": false,
            "width": 1024,
            "height": 1024,
            "batch": 1
          }
        },
        {
          "id": "end-1",
          "type": "end",
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "start-1",
          "target": "t2i-1"
        },
        {
          "id": "e2",
          "source": "t2i-1",
          "target": "end-1"
        }
      ]
    },
    {
      "id": "image_batch",
      "name": "分镜批量出图",
      "summary": "一段描述拆成多张分镜图，一次模型加载批量出（比逐张省重复装载）",
      "output": "image",
      "est_seconds": 180,
      "fields": [
        {
          "key": "prompt",
          "label": "故事/场景描述",
          "type": "textarea",
          "required": true,
          "hint": "一段话即可，拆镜由本地 LLM 完成",
          "bind": [
            {
              "node": "start-1",
              "path": "prompt"
            }
          ]
        },
        {
          "key": "width",
          "label": "宽",
          "type": "int",
          "default": 1024,
          "min": 384,
          "max": 1536,
          "bind": [
            {
              "node": "t2i-1",
              "path": "width"
            }
          ]
        },
        {
          "key": "height",
          "label": "高",
          "type": "int",
          "default": 1024,
          "min": 384,
          "max": 1536,
          "bind": [
            {
              "node": "t2i-1",
              "path": "height"
            }
          ]
        }
      ],
      "nodes": [
        {
          "id": "start-1",
          "type": "start",
          "data": {
            "prompt": ""
          }
        },
        {
          "id": "llm-1",
          "type": "llm",
          "data": {
            "model": "",
            "prompt": "把上面的描述拆成分镜：每行一个英文画面描述，不要编号、不要解释、不要多余文字。",
            "text": ""
          }
        },
        {
          "id": "t2i-1",
          "type": "text2image",
          "data": {
            "prompt": "",
            "prompts": "",
            "split_lines": true,
            "width": 1024,
            "height": 1024,
            "batch": 1
          }
        },
        {
          "id": "end-1",
          "type": "end",
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "start-1",
          "target": "llm-1"
        },
        {
          "id": "e2",
          "source": "llm-1",
          "target": "t2i-1"
        },
        {
          "id": "e3",
          "source": "t2i-1",
          "target": "end-1"
        }
      ]
    },
    {
      "id": "image_edit",
      "name": "图像编辑",
      "summary": "改风格 / 局部重绘 / 超分放大，三种动作一条入口",
      "output": "image",
      "est_seconds": 40,
      "fields": [
        {
          "key": "mode",
          "label": "动作",
          "type": "enum",
          "default": "restyle",
          "options": [
            "restyle",
            "inpaint",
            "upscale"
          ],
          "hint": "restyle=按强度重绘（0.85 以上才明显改风格）· inpaint=蒙版区域重画（默认 flux-schnell，属弱修补；要专业重绘把 model 换成 Fill 模型）· upscale=4 倍放大"
        },
        {
          "key": "image_path",
          "label": "原图路径",
          "type": "path",
          "required": true,
          "bind": [
            {
              "node": "i2i-1",
              "path": "image_path"
            },
            {
              "node": "inp-1",
              "path": "image_path"
            },
            {
              "node": "up-1",
              "path": "image_path"
            }
          ]
        },
        {
          "key": "prompt",
          "label": "重绘提示词",
          "type": "textarea",
          "default": "watercolor painting on paper, soft washes, visible brush texture",
          "bind": [
            {
              "node": "i2i-1",
              "path": "prompt"
            },
            {
              "node": "inp-1",
              "path": "prompt"
            }
          ]
        },
        {
          "key": "strength",
          "label": "重绘强度",
          "type": "float",
          "default": 0.85,
          "min": 0.2,
          "max": 1,
          "bind": [
            {
              "node": "i2i-1",
              "path": "strength"
            }
          ]
        },
        {
          "key": "mask_path",
          "label": "蒙版路径",
          "type": "path",
          "hint": "仅 inpaint 用：白区被重画，必须与原图同尺寸",
          "bind": [
            {
              "node": "inp-1",
              "path": "mask_path"
            }
          ]
        }
      ],
      "nodes": [
        {
          "id": "start-1",
          "type": "start",
          "data": {
            "prompt": ""
          }
        },
        {
          "id": "i2i-1",
          "type": "image2image",
          "when": "mode=restyle",
          "data": {
            "prompt": "",
            "image_path": "",
            "strength": 0.85,
            "steps": 10
          }
        },
        {
          "id": "inp-1",
          "type": "inpaint",
          "when": "mode=inpaint",
          "data": {
            "prompt": "",
            "image_path": "",
            "mask_path": "",
            "denoise": 1,
            "steps": 10
          }
        },
        {
          "id": "up-1",
          "type": "upscale",
          "when": "mode=upscale",
          "data": {
            "image_path": "",
            "model": "RealESRGAN_x4plus.pth"
          }
        },
        {
          "id": "end-1",
          "type": "end",
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "start-1",
          "target": "i2i-1"
        },
        {
          "id": "e2",
          "source": "start-1",
          "target": "inp-1"
        },
        {
          "id": "e3",
          "source": "start-1",
          "target": "up-1"
        },
        {
          "id": "e4",
          "source": "i2i-1",
          "target": "end-1"
        },
        {
          "id": "e5",
          "source": "inp-1",
          "target": "end-1"
        },
        {
          "id": "e6",
          "source": "up-1",
          "target": "end-1"
        }
      ]
    },
    {
      "id": "video",
      "name": "文生视频（带声音）",
      "summary": "H3 一次推理出画面 + 立体声；608×352×124 帧 ≈ 5 秒",
      "output": "video",
      "est_seconds": 240,
      "fields": [
        {
          "key": "prompt",
          "label": "画面与声音描述",
          "type": "textarea",
          "required": true,
          "hint": "中英文都行。想同时出环境声与配乐，就在描述里写出来",
          "bind": [
            {
              "node": "start-1",
              "path": "prompt"
            }
          ]
        },
        {
          "key": "optimize",
          "label": "提示词优化",
          "type": "bool",
          "default": true,
          "hint": "先用本地 LLM 改写成 H3 三段式（画面/环境声/配乐），压掉人声乱语；给了参考图/音频时自动转六段式",
          "bind": [
            {
              "node": "t2v-1",
              "path": "prompt_opt"
            }
          ]
        },
        {
          "key": "width",
          "label": "宽",
          "type": "int",
          "default": 608,
          "min": 256,
          "max": 1280,
          "bind": [
            {
              "node": "t2v-1",
              "path": "width"
            }
          ]
        },
        {
          "key": "height",
          "label": "高",
          "type": "int",
          "default": 352,
          "min": 256,
          "max": 1280,
          "bind": [
            {
              "node": "t2v-1",
              "path": "height"
            }
          ]
        },
        {
          "key": "frames",
          "label": "帧数",
          "type": "int",
          "default": 124,
          "min": 24,
          "max": 248,
          "hint": "24fps，124 帧 ≈ 5 秒",
          "bind": [
            {
              "node": "t2v-1",
              "path": "frames"
            }
          ]
        },
        {
          "key": "steps",
          "label": "步数",
          "type": "int",
          "default": 12,
          "min": 4,
          "max": 30,
          "bind": [
            {
              "node": "t2v-1",
              "path": "steps"
            }
          ]
        },
        {
          "key": "segments",
          "label": "段数",
          "type": "int",
          "default": 1,
          "min": 1,
          "max": 4,
          "bind": [
            {
              "node": "t2v-1",
              "path": "segments"
            }
          ]
        },
        {
          "key": "qc",
          "label": "质量循环",
          "type": "bool",
          "default": false
        },
        {
          "key": "ref_images",
          "label": "角色参考图（可选）",
          "type": "textarea",
          "default": "",
          "hint": "每行一张路径（≤9），锁定人物外貌；给了就走 Ref2VA，提示词里用 <Picture 1> 引用",
          "bind": [
            {
              "node": "t2v-1",
              "path": "ref_images"
            }
          ]
        },
        {
          "key": "ref_audio",
          "label": "参考音频（可选）",
          "type": "path",
          "default": "",
          "hint": "填一段念稿音频 → 口型同步；只填音频、不填图也会走参考路径",
          "bind": [
            {
              "node": "t2v-1",
              "path": "ref_audio"
            }
          ]
        },
        {
          "key": "text_overlay",
          "label": "贴字（可选）",
          "type": "textarea",
          "default": "",
          "hint": "出片后由 ffmpeg 贴上去的固定文字（标题/招牌）；换行用 \\n。留空=不贴。模型自己写小字/长句会糊，要精确文案就走这里（零显存、可重跑）"
        },
        {
          "key": "overlay_srt",
          "label": "字幕文件（可选）",
          "type": "path",
          "default": "",
          "hint": "填 .srt/.ass 路径就按时间轴烧进画面；填了优先于上面的固定文字"
        },
        {
          "key": "overlay_position",
          "label": "文字位置",
          "type": "text",
          "default": "bottom",
          "hint": "bottom / top / center"
        },
        {
          "key": "overlay_style",
          "label": "文字样式",
          "type": "text",
          "default": "caption",
          "hint": "caption 常规字幕 / title 片名大标题（带淡入与压暗带）/ plate 底板卡片 / lower_third 左下信息条（带金线）"
        },
        {
          "key": "overlay_scale",
          "label": "贴字前上采样高度",
          "type": "int",
          "default": 0,
          "min": 0,
          "max": 1080,
          "hint": "0=保持原分辨率。608×352 直接烧字会像素化，填 720 或 1080 先放大再排字，字才立得住（只上不下）"
        },
        {
          "key": "overlay_size",
          "label": "字号 px",
          "type": "int",
          "default": 0,
          "min": 0,
          "max": 200,
          "hint": "0 = 按画面高度自动（h/22）"
        },
        {
          "key": "overlay_box",
          "label": "文字加底板",
          "type": "bool",
          "default": false,
          "hint": "半透明黑底，花背景上也看得清"
        },
        {
          "key": "overlay_from",
          "label": "出现时间 s",
          "type": "float",
          "default": 0,
          "min": 0,
          "max": 600,
          "hint": "0 = 全程显示"
        },
        {
          "key": "overlay_to",
          "label": "消失时间 s",
          "type": "float",
          "default": -1,
          "min": -1,
          "max": 600,
          "hint": "-1 = 到片尾"
        }
      ],
      "nodes": [
        {
          "id": "start-1",
          "type": "start",
          "data": {
            "prompt": ""
          }
        },
        {
          "id": "t2v-1",
          "type": "text2video",
          "data": {
            "prompt": "",
            "backend": "h3",
            "width": 608,
            "height": 352,
            "frames": 124,
            "fps": 24,
            "negative": "",
            "low_vram": false,
            "segments": 1,
            "interp": false,
            "turbo": false,
            "prompt_opt": true,
            "ref_images": [],
            "ref_audio": []
          }
        },
        {
          "id": "end-1",
          "type": "end",
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "start-1",
          "target": "t2v-1"
        },
        {
          "id": "e2",
          "source": "t2v-1",
          "target": "end-1"
        }
      ]
    },
