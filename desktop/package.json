{
  "name": "flowedge-desktop",
  "version": "1.0.0",
  "description": "FlowEdge 私有化多模态工作流引擎 - 桌面客户端",
  "main": "main.js",
  "author": "FlowEdge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flowedge.desktop",
    "productName": "FlowEdge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/FlowEdge.exe",
        "to": "backend/FlowEdge.exe"
      },
      {
        "from": "../backend/local-services",
        "to": "local-services",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlowEdge"
    }
  }
}
