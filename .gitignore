# 依赖
node_modules/
vendor/

# 构建产物
/frontend/dist/
/dist/
build/

# 内嵌前端产物（构建时生成；保留 .placeholder 让目录在干净 clone 后存在）
backend/web/static/*
!backend/web/static/.placeholder
backend/web/services/files/*
!backend/web/services/files/.placeholder
*.exe
*.dll
*.so
*.dylib

# 测试
*.test
*.out
/frontend/.test-build/

# 环境变量
.env
.env.local

# 数据
*.db
*.sqlite
data/
backend/data/

# 就地运行目录（exe + 本地数据库 + 启动脚本，不属于源码）
/运行/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 临时工作目录（verify-media 抽帧、审计中间产物）
.tmp/

# Python 字节码
__pycache__/
*.pyc

# 本地服务虚拟环境
backend/local-services/.venv/

# 桌面客户端
desktop/node_modules/
desktop/window-screenshot.png
*.exe~

# 本地工作记录（助手记忆，不入库）
.workbuddy/

# Harness 进度文件（本会话产生）
.dsh-progress/

# 本地业务方案文档（含 UE5/资产上下文，不进公开仓库）
docs/动作产线-*
docs/动作生成与动捕*

# 本地生成物与部署目录（公开仓库只收代码与文档）
data/generated/
data/runs/
运行/

# 接口导出的临时 JSON 与手动备份（调试落盘，非源码）
/cards.json
/doc.json
/list.json
/.tmp-modules.json
*.bak-*

# 本地产出目录（截图证据、研究中间产物）
/outputs/

# 轻装化过程中移出的旧文件（可回溯 git，不进仓库）
.slim-trash/
