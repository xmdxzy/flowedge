# 依赖
node_modules/
vendor/

# 构建产物
/frontend/dist/
/dist/
build/

# 内嵌前端产物（构建时生成；保留 .placeholder 让目录在干净 clone 后存在）
backend/web/static/*
!backend/web/static/.placeholder
backend/web/services/files/*
!backend/web/services/files/.placeholder
*.exe
*.dll
*.so
*.dylib

# 测试
*.test
*.out

# 环境变量
.env
.env.local

# 数据
*.db
*.sqlite
data/
backend/data/

# 就地运行目录（exe + 本地数据库 + 启动脚本，不属于源码）
/运行/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 临时工作目录（verify-media 抽帧、审计中间产物）
.tmp/

# Python 字节码
__pycache__/
*.pyc

# 本地服务虚拟环境
backend/local-services/.venv/

# 桌面客户端
desktop/node_modules/
desktop/window-screenshot.png
*.exe~

# 本地工作记录（助手记忆，不入库）
.workbuddy/

# Harness 进度文件（本会话产生）
.dsh-progress/
